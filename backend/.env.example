PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/flyticket
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMTP for e-ticket emails (bonus)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FlyTicket <no-reply@flyticket.local>"

# Default admin (used by seed script)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!

# CORS origin (frontend) — comma-separated for multiple origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
